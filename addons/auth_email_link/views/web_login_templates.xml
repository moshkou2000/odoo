<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="web_login_email_auth" inherit_id="web.login" name="Configurable authentication login">
        <!-- Keep Odoo's original login/user-switch UI intact. This preserves the
             original "Choose a user" placement and the original username/login field. -->
        <xpath expr="//div[contains(@class, 'field-login')]" position="attributes">
            <attribute name="t-if">auth_email_login_mode in ('password', 'both')</attribute>
        </xpath>

        <xpath expr="//div[contains(@class, 'o_caps_lock_warning')]" position="attributes">
            <attribute name="t-if">auth_email_login_mode in ('password', 'both')</attribute>
        </xpath>

        <!-- Dedicated email field: do not repurpose Odoo's original login field. -->
        <xpath expr="//div[contains(@class, 'o_caps_lock_warning')]" position="after">
            <div t-if="auth_email_login_mode in ('email_link', 'both')" class="mt-3">
                <t t-if="auth_email_login_mode == 'both'">
                    <div class="d-flex align-items-center my-3">
                        <div class="border-top flex-grow-1"/>
                        <span class="text-muted small px-2">or use a verification link</span>
                        <div class="border-top flex-grow-1"/>
                    </div>
                </t>
                <label for="email_login" class="form-label">Email</label>
                <input type="email"
                       name="email_login"
                       id="email_login"
                       class="form-control"
                       placeholder="Enter your email"
                       autocomplete="email"
                       autocapitalize="off"
                       t-att-required="'required' if auth_email_login_mode == 'email_link' else None"/>
            </div>
        </xpath>

        <!-- Preserve the native button container and OAuth rendering. -->
        <xpath expr="//div[contains(@class, 'oe_login_buttons')]/button[@type='submit'][1]" position="attributes">
            <attribute name="t-if">auth_email_login_mode in ('password', 'both')</attribute>
        </xpath>

        <xpath expr="//div[contains(@class, 'oe_login_buttons')]/button[@type='submit'][1]" position="after">
            <button t-if="auth_email_login_mode in ('email_link', 'both')"
                    type="submit"
                    name="type"
                    value="email_link"
                    class="btn btn-primary mt-2">
                Send login link
            </button>
        </xpath>

        <xpath expr="//input[@name='type' and @value='password']" position="attributes">
            <attribute name="t-if">auth_email_login_mode in ('password', 'both')</attribute>
        </xpath>
    </template>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_email_login" model="mail.template">
            <field name="name">Email Login Link</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="subject">Your login link</field>
            <field name="email_from">{{ user.email_formatted }}</field>
            <field name="partner_to" eval="False"/>
            <field name="email_to">{{ object.email }}</field>
            <field name="use_default_to" eval="False"/>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
                <div style="font-family:Arial,sans-serif;max-width:600px;margin:auto;">
                    <h2>Sign in to <t t-out="object.company_id.name or 'Odoo'"/></h2>
                    <p>Hello <t t-out="object.name or ''"/>,</p>
                    <p>Use the button below to sign in. This link can only be used once.</p>
                    <p style="margin:24px 0;">
                        <a t-att-href="ctx.get('login_url')"
                           style="padding:12px 20px;background:#714B67;color:#fff;text-decoration:none;border-radius:4px;">
                            Sign in to Odoo
                        </a>
                    </p>
                    <p style="color:#777;font-size:12px;">
                        If you did not request this login link, you can safely ignore this email.
                    </p>
                </div>
            </field>
        </record>
    </data>
</odoo>
